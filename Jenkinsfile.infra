pipeline {
    agent any

    parameters {
        choice(name: 'STACK', choices: ['eks', 'cicd-server'], description: 'Terraform stack to run.')
        choice(name: 'ACTION', choices: ['plan', 'apply'], description: 'Terraform action.')
    }

    environment {
        AWS_CREDENTIALS_ID = 'aws-creds'
        AWS_REGION         = 'ca-central-1'
        ALERT_EMAIL        = 's12yemi.wft@gmail.com'
    }

    stages {
        stage('Select Stack') {
            steps {
                script {
                    env.TERRAFORM_DIR = params.STACK == 'eks' ? 'iac/eks' : 'iac'
                    echo "Using Terraform stack: ${env.TERRAFORM_DIR}"
                }
            }
        }

        stage('Terraform Format') {
            steps {
                sh "terraform -chdir=${env.TERRAFORM_DIR} fmt -check -recursive"
            }
        }

        stage('Terraform Init') {
            steps {
                script {
                    withAWS(credentials: "${env.AWS_CREDENTIALS_ID}", region: "${env.AWS_REGION}") {
                        sh "terraform -chdir=${env.TERRAFORM_DIR} init -input=false"
                    }
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                sh "terraform -chdir=${env.TERRAFORM_DIR} validate"
            }
        }

        stage('Terraform Plan') {
            steps {
                script {
                    withAWS(credentials: "${env.AWS_CREDENTIALS_ID}", region: "${env.AWS_REGION}") {
                        sh "terraform -chdir=${env.TERRAFORM_DIR} plan -out=tfplan -input=false"
                    }
                }
            }
        }

        stage('Terraform Apply') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                input message: "Apply Terraform changes for ${params.STACK}?", ok: 'Apply'
                script {
                    withAWS(credentials: "${env.AWS_CREDENTIALS_ID}", region: "${env.AWS_REGION}") {
                        sh "terraform -chdir=${env.TERRAFORM_DIR} apply -input=false tfplan"
                    }
                }
            }
        }
    }

    post {
        success {
            mail(
                to: "${env.ALERT_EMAIL}",
                subject: "DHL Infra ${params.ACTION} Passed: ${params.STACK}",
                body: "Terraform ${params.ACTION} completed successfully for ${params.STACK}."
            )
        }

        failure {
            mail(
                to: "${env.ALERT_EMAIL}",
                subject: "DHL Infra ${params.ACTION} Failed: ${params.STACK}",
                body: "Terraform ${params.ACTION} failed for ${params.STACK}. Check Jenkins logs: ${env.BUILD_URL}"
            )
        }
    }
}
